{
  "name": "litely",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Litely — fast, private browser tools for images, PDFs, QR codes, passwords and color palettes.",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "npm run icons",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node tests/smoke-pure.ts && node tests/smoke-pdf.mjs && node tests/pdf-worker-modes.ts && node tests/pdf-image-merge-visible.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}
